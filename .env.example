# Trimble ID (public PKCE client, application "tc-Site-Pass"). Copy to .env.local for Vite,
# or set the same names in the Vercel project. Redirect URLs may be omitted: the app then
# uses window.location.origin + /callback and /logout-callback.
VITE_CONFIGURATION_ENDPOINT=https://id.trimble.com/.well-known/openid-configuration
VITE_CLIENT_ID=c0cc765f-6230-4e95-a127-5f5921b49805
VITE_SCOPES=tc-Site-Pass
# VITE_REDIRECT_URL=http://localhost:5173/callback
# VITE_LOGOUT_REDIRECT_URL=http://localhost:5173/logout-callback
